<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.guidinglight</groupId>
    <artifactId>dh-bom</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <relativePath>../dh-bom/pom.xml</relativePath>
  </parent>

  <artifactId>dh-app</artifactId>
  <properties>
    <qdr7.powershell.executable>AUTO</qdr7.powershell.executable>
    <qdr7.implementationValidation>false</qdr7.implementationValidation>
  </properties>
  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <!--
      Flyway 10+ 将各数据库支持拆分为独立模块；缺少 flyway-database-postgresql 时对 PostgreSQL（含 17.x）
      报 "Unsupported Database"。版本由 spring-boot-starter-parent(3.5.10) 统一管理，与 flyway-core 对齐。
    -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>

    <dependency>
      <groupId>com.guidinglight</groupId>
      <artifactId>dh-api</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.guidinglight</groupId>
      <artifactId>dh-infra</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.guidinglight</groupId>
      <artifactId>dh-observability</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.guidinglight</groupId>
      <artifactId>dh-security</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.guidinglight</groupId>
      <artifactId>dh-eval</artifactId>
      <version>${project.version}</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>postgresql</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <excludes>
            <exclude>**/*IT.java</exclude>
          </excludes>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>qdr7-capacity-acceptance</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <version>3.5.0</version>
            <executions>
              <execution>
                <id>qdr7-capacity-preflight</id>
                <phase>pre-integration-test</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <executable>powershell.exe</executable>
                  <arguments>
                    <argument>-NoProfile</argument>
                    <argument>-NonInteractive</argument>
                    <argument>-ExecutionPolicy</argument>
                    <argument>Bypass</argument>
                    <argument>-File</argument>
                    <argument>${maven.multiModuleProjectDirectory}/scripts/qdr7-capacity/Invoke-Qdr7CapacityAcceptance.ps1</argument>
                    <argument>-Phase</argument>
                    <argument>Preflight</argument>
                    <argument>-RunId</argument>
                    <argument>${qdr7.runId}</argument>
                    <argument>-Seed</argument>
                    <argument>${qdr7.seed}</argument>
                    <argument>-ProjectRoot</argument>
                    <argument>${maven.multiModuleProjectDirectory}</argument>
                    <argument>-PowerShellExecutable</argument>
                    <argument>${qdr7.powershell.executable}</argument>
                    <argument>-ImplementationValidation</argument>
                    <argument>${qdr7.implementationValidation}</argument>
                  </arguments>
                </configuration>
              </execution>
              <execution>
                <id>qdr7-capacity-finalize</id>
                <phase>post-integration-test</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <executable>powershell.exe</executable>
                  <arguments>
                    <argument>-NoProfile</argument>
                    <argument>-NonInteractive</argument>
                    <argument>-ExecutionPolicy</argument>
                    <argument>Bypass</argument>
                    <argument>-File</argument>
                    <argument>${maven.multiModuleProjectDirectory}/scripts/qdr7-capacity/Invoke-Qdr7CapacityAcceptance.ps1</argument>
                    <argument>-Phase</argument>
                    <argument>Finalize</argument>
                    <argument>-RunId</argument>
                    <argument>${qdr7.runId}</argument>
                    <argument>-Seed</argument>
                    <argument>${qdr7.seed}</argument>
                    <argument>-ProjectRoot</argument>
                    <argument>${maven.multiModuleProjectDirectory}</argument>
                    <argument>-PowerShellExecutable</argument>
                    <argument>${qdr7.powershell.executable}</argument>
                    <argument>-ImplementationValidation</argument>
                    <argument>${qdr7.implementationValidation}</argument>
                  </arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-failsafe-plugin</artifactId>
            <version>3.2.5</version>
            <configuration>
              <includes>
                <include>**/Qdr7CapacityAcceptanceIT.java</include>
              </includes>
              <systemPropertyVariables>
                <qdr7.capacity.profile.active>true</qdr7.capacity.profile.active>
                <qdr7.runId>${qdr7.runId}</qdr7.runId>
                <qdr7.seed>${qdr7.seed}</qdr7.seed>
                <qdr7.projectRoot>${maven.multiModuleProjectDirectory}</qdr7.projectRoot>
                <qdr7.implementationValidation>${qdr7.implementationValidation}</qdr7.implementationValidation>
              </systemPropertyVariables>
            </configuration>
            <executions>
              <execution>
                <id>qdr7-capacity-failsafe</id>
                <goals>
                  <goal>integration-test</goal>
                  <goal>verify</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>

</project>
