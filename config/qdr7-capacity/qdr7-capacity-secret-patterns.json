{
  "schemaVersion": "qdr7-capacity-1",
  "patternsVersion": "qdr7-capacity-secret-patterns-1",
  "patterns": [
    {"id": "authorization-bearer", "regex": "(?i)authorization\\s*[:=]\\s*bearer\\s+[a-z0-9._~+/-]{8,}"},
    {"id": "credential-key", "regex": "(?i)(api[_-]?key|api[_-]?secret|passphrase|password|token|cookie)\\s*[:=]\\s*[^\\s,;]{6,}"},
    {"id": "private-key-header", "regex": "-----BEGIN (RSA |EC |OPENSSH )?PRIVATE KEY-----"},
    {"id": "raw-signature", "regex": "(?i)(x-nq-dh-signature|signature)\\s*[:=]\\s*[a-f0-9]{32,}"},
    {"id": "raw-hmac", "regex": "(?i)(hmac|hmac-secret)\\s*[:=]\\s*[^\\s,;]{8,}"},
    {"id": "jdbc-password", "regex": "(?i)(jdbc:[^\\s]+[?&]password=|spring\\.datasource\\.password\\s*=)"},
    {"id": "common-token-prefix", "regex": "(?i)(sk-|ghp_|github_pat_|xox[baprs]-)[a-z0-9_-]{12,}"}
  ]
}
