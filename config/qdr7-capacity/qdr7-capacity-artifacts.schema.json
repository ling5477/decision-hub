{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://decision-hub.local/schema/qdr7-capacity-artifacts.schema.json",
  "title": "Decision Hub Stage-QDR-7 capacity artifact",
  "type": "object",
  "required": [
    "schemaVersion",
    "runId",
    "commitSha",
    "scenario",
    "status",
    "startedAtUtc",
    "finishedAtUtc",
    "durationMs",
    "seed",
    "unitSystem",
    "missingValues"
  ],
  "properties": {
    "schemaVersion": {"const": "qdr7-capacity-1"},
    "runId": {"type": "string", "pattern": "^[0-9]{8}T[0-9]{6}Z$"},
    "commitSha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "scenario": {"type": "string", "minLength": 1},
    "status": {"enum": ["PASS", "FAIL", "BLOCKED", "NOT_RUN"]},
    "startedAtUtc": {"type": "string", "format": "date-time"},
    "finishedAtUtc": {"type": "string", "format": "date-time"},
    "durationMs": {"type": "integer", "minimum": 0},
    "seed": {"const": 7},
    "unitSystem": {"const": "milliseconds-bytes-requestsPerSecond-percent-rfc3339-utc"},
    "missingValues": {"type": "array", "items": {"type": "string"}},
    "criteriaVersion": {"const": "qdr7-capacity-criteria-1"}
  },
  "additionalProperties": true
}
