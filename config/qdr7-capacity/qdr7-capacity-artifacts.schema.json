{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://decision-hub.local/schema/qdr7-capacity-artifacts.schema.json",
  "title": "Decision Hub Stage-QDR-7 capacity artifact",
  "type": "object",
  "required": [
    "schemaVersion",
    "runId",
    "commitSha",
    "scenario",
    "status",
    "startedAtUtc",
    "finishedAtUtc",
    "durationMs",
    "seed",
    "unitSystem",
    "missingValues"
    ,"attemptId"
    ,"candidateSha"
    ,"candidateTree"
    ,"profileId"
    ,"profileVersion"
    ,"scenarioSetHash"
    ,"thresholdSetHash"
    ,"environmentManifestHash"
    ,"harnessVersion"
    ,"harnessHash"
    ,"generatedAt"
  ],
  "properties": {
    "schemaVersion": {"const": "qdr7-capacity-1"},
    "runId": {"type": "string", "pattern": "^[0-9]{8}T[0-9]{6}Z$"},
    "commitSha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "scenario": {"type": "string", "minLength": 1},
    "status": {"enum": ["PASS", "FAIL", "BLOCKED", "NOT_RUN", "NOT_FORMAL", "QUALIFIED", "NOT_QUALIFIED", "INVALID"]},
    "startedAtUtc": {"type": "string", "format": "date-time"},
    "finishedAtUtc": {"type": "string", "format": "date-time"},
    "durationMs": {"type": "integer", "minimum": 0},
    "seed": {"const": 7},
    "unitSystem": {"const": "milliseconds-bytes-requestsPerSecond-percent-rfc3339-utc"},
    "missingValues": {"type": "array", "items": {"type": "string"}},
    "attemptId": {"type": "string", "pattern": "^[0-9]{8}T[0-9]{6}Z$"},
    "candidateSha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "candidateTree": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "profileId": {"const": "qdr7-capacity-acceptance"},
    "profileVersion": {"const": "qdr7-capacity-criteria-1"},
    "scenarioSetHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "thresholdSetHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "environmentManifestHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "harnessVersion": {"type": "string", "minLength": 1},
    "harnessHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "generatedAt": {"type": "string", "format": "date-time"},
    "criteriaVersion": {"const": "qdr7-capacity-criteria-1"},
    "startedAt": {"type": "string", "format": "date-time"},
    "completedAt": {"type": "string", "format": "date-time"},
    "internalExitCode": {"type": "integer"},
    "mandatoryScenarioCount": {"const": 15},
    "startedScenarioCount": {"type": "integer", "minimum": 0, "maximum": 15},
    "partialScenarioCount": {"type": "integer", "minimum": 0, "maximum": 15},
    "completedScenarioCount": {"type": "integer", "minimum": 0, "maximum": 15},
    "passedScenarioCount": {"type": "integer", "minimum": 0, "maximum": 15},
    "failedScenarioCount": {"type": "integer", "minimum": 0, "maximum": 15},
    "blockedScenarioCount": {"type": "integer", "minimum": 0, "maximum": 15},
    "notStartedScenarioCount": {"type": "integer", "minimum": 0, "maximum": 15},
    "executedScenarioCount": {"type": "integer", "minimum": 0, "maximum": 15},
    "correctnessVerdict": {"enum": ["PASS", "FAIL", "BLOCKED", "NOT_RUN"]},
    "thresholdVerdict": {"enum": ["PASS", "FAIL", "BLOCKED", "NOT_RUN"]},
    "regressionVerdict": {"enum": ["PASS", "FAIL", "BLOCKED", "NOT_RUN"]},
    "qualityVerdict": {"enum": ["PASS", "FAIL", "BLOCKED", "NOT_RUN"]},
    "artifactVerdict": {"enum": ["PASS", "BLOCKED", "PENDING"]},
    "secretVerdict": {"enum": ["PASS", "FAIL", "PENDING"]},
    "teardownVerdict": {"enum": ["PASS", "BLOCKED"]},
    "reasonCode": {"type": "string", "minLength": 1},
    "capacityAcceptanceExecuted": {"type": "boolean"},
    "formalAcceptanceVerdict": {"enum": ["NOT_EVALUATED", "PASS_WITHIN_FROZEN_PROFILE", "FAIL", "BLOCKED", "INVALID"]},
    "qualificationVerdict": {"enum": ["NOT_EVALUATED", "PASS", "FAIL", "BLOCKED"]},
    "executionState": {"enum": ["NOT_STARTED", "STARTED", "PARTIAL", "COMPLETED"]},
    "verdict": {"enum": ["NOT_EVALUATED", "PASS_WITHIN_FROZEN_PROFILE", "PASS", "FAIL", "BLOCKED", "INVALID"]},
    "roundsRequired": {"type": "integer", "minimum": 0},
    "roundsStarted": {"type": "integer", "minimum": 0},
    "roundsCompleted": {"type": "integer", "minimum": 0},
    "measurementsCaptured": {"type": "integer", "minimum": 0},
    "comparisonsExecuted": {"type": "integer", "minimum": 0},
    "artifactRefs": {"type": "array", "items": {"type": "string"}}
  },
  "allOf": [
    {
      "if": {"properties": {"scenario": {"const": "capacity-acceptance"}}},
      "then": {
        "required": [
          "criteriaVersion",
          "startedAt",
          "completedAt",
          "internalExitCode",
          "mandatoryScenarioCount",
          "startedScenarioCount",
          "partialScenarioCount",
          "completedScenarioCount",
          "passedScenarioCount",
          "failedScenarioCount",
          "blockedScenarioCount",
          "notStartedScenarioCount",
          "executedScenarioCount",
          "correctnessVerdict",
          "thresholdVerdict",
          "regressionVerdict",
          "qualityVerdict",
          "artifactVerdict",
          "secretVerdict",
          "teardownVerdict",
          "reasonCode",
          "capacityAcceptanceExecuted",
          "formalAcceptanceVerdict",
          "qualificationVerdict"
        ]
      }
    },
    {
      "if": {"properties": {"scenario": {"const": "scenario-ledger"}}},
      "then": {
        "required": ["scenarios"],
        "properties": {
          "scenarios": {
            "type": "array",
            "minItems": 15,
            "maxItems": 15,
            "items": {
              "type": "object",
              "required": [
                "scenarioId",
                "mandatory",
                "executionState",
                "verdict",
                "startedAt",
                "completedAt",
                "roundsRequired",
                "roundsStarted",
                "roundsCompleted",
                "measurementsCaptured",
                "comparisonsExecuted",
                "reasonCode",
                "artifactRefs"
              ]
            }
          }
        }
      }
    }
  ],
  "additionalProperties": true
}
